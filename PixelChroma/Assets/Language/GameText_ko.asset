  - m_Id: 3000000000000029
    m_Localized: "\uAC8C\uC784 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000030
    m_Localized: "Steam\uC5D0 \uC5F0\uACB0\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\nSteam
      \uD074\uB77C\uC774\uC5B8\uD2B8\uAC00 \uC2E4\uD589 \uC911\uC778\uC9C0 \uD655\uC778
