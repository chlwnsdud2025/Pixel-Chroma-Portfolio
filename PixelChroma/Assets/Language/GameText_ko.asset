      m_Items: []
  - m_Id: 7000000000000001
    m_Localized: "\uC774\uBBF8 \uBC29\uC5D0 \uC811\uC18D \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000002
    m_Localized: "\uBC29 \uC0DD\uC131\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000003
    m_Localized: "\uACF5\uAC1C\uBC29\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000004
    m_Localized: "\uD574\uB2F9 \uCF54\uB4DC\uC758 \uBC29\uC744 \uCC3E\uC744 \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000005
    m_Localized: "\uBC29 \uC785\uC7A5\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000006
    m_Localized: "\uC11C\uBC84\uC5D0 \uC5F0\uACB0\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000007
    m_Localized: "\uC11C\uBC84\uC640\uC758 \uC5F0\uACB0\uC774 \uB04A\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000008
    m_Localized: "\uC751\uB2F5 \uC2DC\uAC04\uC774 \uCD08\uACFC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000011
    m_Localized: "이미 게임이 시작된 방입니다."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000009
    m_Localized: "\uC54C \uC218 \uC5C6\uB294 \uC624\uB958\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000010
    m_Localized: "\uB2C9\uB124\uC784\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uB294
      \uBB38\uC790\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
