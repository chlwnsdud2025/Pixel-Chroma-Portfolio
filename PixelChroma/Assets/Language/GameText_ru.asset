  - m_Id: 3000000000000041
    m_Localized: Тень
    m_Metadata:
      m_Items: []
  - m_Id: 12956041266868224
    m_Localized: "\u0420\u0430\u0441\u043a\u0440\u0430\u0441\u044c\u0442\u0435
      \u0441\u0435\u0431\u044f \u0442\u0430\u043a, \u0447\u0442\u043e\u0431\u044b
      \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u0441\u043e\u0432\u043f\u0430\u0441\u0442\u044c
      \u0441 \u0446\u0432\u0435\u0442\u0430\u043c\u0438 \u0444\u043e\u043d\u0430.
      \u0413\u043b\u0430\u0437\u0430 \u0418\u0441\u043a\u0430\u0442\u0435\u043b\u044f
      \u043d\u0435 \u0442\u0430\u043a \u0437\u043e\u0440\u043a\u0438, \u043a\u0430\u043a
      \u0432\u0430\u043c \u043a\u0430\u0436\u0435\u0442\u0441\u044f."
    m_Metadata:
      m_Items: []
  - m_Id: 12956043007504384
    m_Localized: "\u041a\u0430\u043a \u0431\u044b \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e
      \u0432\u044b \u043d\u0438 \u0437\u0430\u043c\u0430\u0441\u043a\u0438\u0440\u043e\u0432\u0430\u043b\u0438\u0441\u044c,
      \u0434\u0432\u0438\u0436\u0443\u0449\u0430\u044f\u0441\u044f \u0442\u043e\u0447\u043a\u0430
      \u2014 \u0441\u0430\u043c\u0430\u044f \u043b\u0451\u0433\u043a\u0430\u044f
      \u0434\u043e\u0431\u044b\u0447\u0430 \u0434\u043b\u044f \u0418\u0441\u043a\u0430\u0442\u0435\u043b\u044f."
    m_Metadata:
      m_Items: []
  - m_Id: 12956043611484160
    m_Localized: "\u0412 \u0440\u0435\u0436\u0438\u043c\u0435 \u0417\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f
      \u0441\u043e\u044e\u0437\u043d\u0438\u043a\u0438 \u043c\u043e\u0433\u0443\u0442
      \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u0441\u0442\u0430\u0442\u044c
      \u0418\u0441\u043a\u0430\u0442\u0435\u043b\u044f\u043c\u0438.\n \u041d\u0435
      \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0434\u043e\u0432\u0435\u0440\u044f\u0439\u0442\u0435
      \u0442\u043e\u043c\u0443, \u043a\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e
      \u0447\u0442\u043e \u0441\u043f\u0440\u044f\u0442\u0430\u043b\u0441\u044f
      \u0440\u044f\u0434\u043e\u043c \u0441 \u0432\u0430\u043c\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 12956044215463936
    m_Localized: "\u0412\u044b \u043a\u043e\u0433\u0434\u0430-\u043d\u0438\u0431\u0443\u0434\u044c
      \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u043b\u0438 \u0432\u043e\u0441\u0442\u043e\u0440\u0433,
      \u043a\u043e\u0433\u0434\u0430 \u0418\u0441\u043a\u0430\u0442\u0435\u043b\u044c
      \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442 \u043f\u0440\u044f\u043c\u043e
      \u043c\u0438\u043c\u043e \u0432\u0430\u0448\u0435\u0433\u043e \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e
      \u0443\u043a\u0440\u044b\u0442\u0438\u044f?"
    m_Metadata:
      m_Items: []
  - m_Id: 12957270562844672
    m_Localized: "\"\u041f\u043e\u0434\u043e\u0436\u0434\u0438, \u043a\u043e\u0433\u0434\u0430
      \u0442\u044b \u0441\u0442\u0430\u043b \u0418\u0441\u043a\u0430\u0442\u0435\u043b\u0435\u043c?\"
      \u2014 \u0421\u0430\u043c\u044b\u0435 \u0447\u0430\u0441\u0442\u044b\u0435
      \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0441\u043b\u043e\u0432\u0430
      \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u0417\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f."
