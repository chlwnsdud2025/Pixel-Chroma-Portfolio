    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000017
    m_Localized: "Olu\u015Ftur"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000018
    m_Localized: "D\xFCzenle"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000019
    m_Localized: "Huzurlu Oturma Odas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000020
    m_Localized: "K\xFCt\xFCphane"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000021
    m_Localized: "Z\xFCmr\xFCt Ovalar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000022
    m_Localized: "Antik Tap\u0131nak"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000023
    m_Localized: "Uyum K\u0131tas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000024
    m_Localized: "\xC7orak Toprak"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000025
    m_Localized: "Oda Ayarlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000026
    m_Localized: "Oda Se\xE7enekleri"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000027
    m_Localized: "Haz\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000028
    m_Localized: "Oyunu Ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 4369809666486272
    m_Localized: Bekleniyor...
    m_Metadata:
      m_Items: []
  - m_Id: 4369812187262976
    m_Localized: "Saklanma Zaman\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 4369812891906048
    m_Localized: "Arama Zaman\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 4369813831430144
    m_Localized: "Kontrol Zaman\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 4369814536073216
    m_Localized: Oyun Bitti!
    m_Metadata:
      m_Items: []
  - m_Id: 4369815169413120
    m_Localized: "Aray\u0131c\u0131lar Kazand\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 4369815806947328
    m_Localized: "Chroma'lar Kazand\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 4369817820213248
    m_Localized: Chroma
    m_Metadata:
      m_Items: []
  - m_Id: 4369820538122240
    m_Localized: "Aray\u0131c\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 4370371904548864
    m_Localized: Boyama Modu
    m_Metadata:
      m_Items: []
  - m_Id: 4370372508528640
    m_Localized: "\u0130zleyici Modu"
    m_Metadata:
      m_Items: []
  - m_Id: 4370372800000000
    m_Localized: "\u015Eekil De\u011Fi\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 4370373112508416
    m_Localized: "Kamera Yak\u0131nla\u015Ft\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 4370373682933760
    m_Localized: "F\u0131r\xE7a Boyutu"
    m_Metadata:
      m_Items: []
  - m_Id: 4370374689566720
    m_Localized: Sohbet
    m_Metadata:
      m_Items: []
  - m_Id: 4370652956471296
    m_Localized: Chroma
    m_Metadata:
      m_Items: []
  - m_Id: 4370653594005504
    m_Localized: "Aray\u0131c\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 4370654231539712
    m_Localized: Serbest
    m_Metadata:
      m_Items: []
  - m_Id: 4393127467560960
    m_Localized: "Serbest G\xF6r\xFCn\xFCm"
    m_Metadata:
      m_Items: []
  - m_Id: 5000000000000001
    m_Localized: Mesaj girin...
    m_Metadata:
      m_Items: []
  - m_Id: 4637565074812928
    m_Localized: "Yaln\u0131zca harf ve rakam girilebilir."
    m_Metadata:
      m_Items: []
  - m_Id: 4754675859992576
    m_Localized: "\xD6v"
    m_Metadata:
      m_Items: []
  - m_Id: 4754677101506560
    m_Localized: "Ayr\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 4754677835509760
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 4754678779228160
    m_Localized: At
    m_Metadata:
      m_Items: []
  - m_Id: 5001295856394240
    m_Localized: "Shaolin Tap\u0131na\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 5001514648068096
    m_Localized: "Kayal\u0131k Da\u011F"
    m_Metadata:
      m_Items: []
  - m_Id: 5001668713242624
    m_Localized: "Kiraz \xC7i\xE7e\u011Fi K\xF6y\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 5001747381608448
    m_Localized: Toplum Merkezi
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000016
    m_Localized: Rastgele
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000029
    m_Localized: "Oyundan \xC7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000030
    m_Localized: "Steam'e ba\u011Flan\u0131lam\u0131yor.\nSteam istemcisinin \xE7al\u0131\u015Ft\u0131\u011F\u0131ndan
      emin olun ve oyunu yeniden ba\u015Flat\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000031
    m_Localized: "Aray\u0131c\u0131 i\xE7in g\xF6n\xFCll\xFC ol!"
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000001
    m_Localized: Korece
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000002
    m_Localized: "\u0130ngilizce"
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000003
    m_Localized: Japonca
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000004
    m_Localized: "\xC7ince (Basitle\u015Ftirilmi\u015F)"
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000005
    m_Localized: "\xC7ince (Geleneksel)"
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000006
    m_Localized: "\u0130spanyolca"
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000007
    m_Localized: Almanca
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000008
    m_Localized: "Frans\u0131zca"
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000009
    m_Localized: "\u0130talyanca"
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000010
    m_Localized: Portekizce (Brezilya)
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000011
    m_Localized: "Leh\xE7e"
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000012
    m_Localized: "Rus\xE7a"
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000013
    m_Localized: "T\xFCrk\xE7e"
    m_Metadata:
      m_Items: []
  - m_Id: 7614089017176064
    m_Localized: "Herkes yakaland\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 7614091227574272
    m_Localized: "S\xFCre doldu"
    m_Metadata:
      m_Items: []
  - m_Id: 900000000000000001
    m_Localized: "Oda olu\u015Fturuluyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000001
    m_Localized: "Zaten bir odadas\u0131n\u0131z."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000002
    m_Localized: "Oda olu\u015Fturulamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000003
    m_Localized: "Herkese a\xE7\u0131k oda bulunamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000004
    m_Localized: "Bu koda ait oda bulunamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000005
    m_Localized: "Odaya kat\u0131lma ba\u015Far\u0131s\u0131z oldu."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000006
    m_Localized: "Sunucuya ba\u011Flan\u0131lamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000007
    m_Localized: "Sunucuyla ba\u011Flant\u0131 kesildi."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000008
    m_Localized: "\u0130stek zaman a\u015F\u0131m\u0131na u\u011Frad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000011
    m_Localized: "Bu odada oyun \xE7oktan ba\u015Flad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000009
    m_Localized: "Bilinmeyen bir hata olu\u015Ftu."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000010
    m_Localized: "Takma ad desteklenmeyen karakterler i\xE7eriyor."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000032
    m_Localized: "A\xE7\u0131\u011Fa \xE7\u0131karmay\u0131 a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000033
    m_Localized: "Kapal\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000001
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000002
    m_Localized: Ses
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000003
    m_Localized: Ekran
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000004
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000005
    m_Localized: Ana Ses
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000006
    m_Localized: BGM
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000007
    m_Localized: Efektler
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000009
    m_Localized: "\xC7\xF6z\xFCn\xFCrl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000010
    m_Localized: Dikey Senkr.
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000011
    m_Localized: "Ekran Sars\u0131nt\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000012
    m_Localized: Tam Ekran
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000015
    m_Localized: "Ana Men\xFCye"
    m_Metadata:
      m_Items: []
  - m_Id: 9000000000000001
    m_Localized: "Bu oda bir At\xF6lye haritas\u0131 kullan\u0131yor.\nAbone olup
      kat\u0131lmak ister misiniz?"
    m_Metadata:
      m_Items: []
  - m_Id: 9000000000000002
    m_Localized: Abone Ol
    m_Metadata:
      m_Items: []
  - m_Id: 9000000000000003
    m_Localized: Abone olunuyor...
    m_Metadata:
      m_Items: []
  - m_Id: 9000000000000004
    m_Localized: "\u0130ndiriliyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 9000000000000005
    m_Localized: "\u0130ndirme zaman a\u015F\u0131m\u0131na u\u011Frad\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 9000000000000006
    m_Localized: "Tamamland\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 9000000000000007
    m_Localized: "Abone olunamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 900000000000000010
    m_Localized: "Su tabancas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 900000000000000011
    m_Localized: Alay et
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000036
    m_Localized: "L\xFCtfen bir oda ad\u0131 girin."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000037
    m_Localized: "Oda ad\u0131n\u0131 girin."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000038
    m_Localized: "Zamanlay\u0131c\u0131 ayarlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000039
    m_Localized: "Kontur ayarlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000040
    m_Localized: Vurgu
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000041
    m_Localized: "G\xF6lge"
    m_Metadata:
      m_Items: []
  - m_Id: 12956041266868224
    m_Localized: "Arka plan renklerine m\xFCkemmel \u015Fekilde uyacak bi\xE7imde
      kendini boya. Aray\u0131c\u0131n\u0131n g\xF6zleri d\xFC\u015F\xFCnd\xFC\u011F\xFCn
      kadar keskin de\u011Fil."
    m_Metadata:
      m_Items: []
  - m_Id: 12956043007504384
    m_Localized: "Ne kadar m\xFCkemmel gizlenirsen gizlen, hareket eden bir nokta
      Aray\u0131c\u0131 i\xE7in en kolay avd\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 12956043611484160
    m_Localized: "Enfeksiyon modunda, m\xFCttefiklerin bir anda Aray\u0131c\u0131ya
      d\xF6n\xFC\u015Febilir.\n Az \xF6nce yan\u0131na saklanan ki\u015Fiye fazla
      g\xFCvenme!"
    m_Metadata:
      m_Items: []
  - m_Id: 12956044215463936
    m_Localized: "M\xFCkemmel sakland\u0131\u011F\u0131nda Aray\u0131c\u0131n\u0131n
      tam \xF6n\xFCnden ge\xE7mesinin o heyecan\u0131n\u0131 hi\xE7 hissettin mi?"
    m_Metadata:
      m_Items: []
  - m_Id: 12957270562844672
    m_Localized: "\"Dur, sen ne zaman Aray\u0131c\u0131 oldun?\" \u2014 Enfeksiyon
      modunda en s\u0131k duyulan son s\xF6zler."
    m_Metadata:
      m_Items: []
  - m_Id: 13402676245573632
    m_Localized: "Ad\u0131n\u0131 \xE7iz!"
    m_Metadata:
      m_Items: []
  - m_Id: 13402680095944704
    m_Localized: "\xD6nizleme"
    m_Metadata:
      m_Items: []
  - m_Id: 13403345614548992
    m_Localized: "S\u0131f\u0131rla"
    m_Metadata:
      m_Items: []
  - m_Id: 14909299501838336
    m_Localized: "[\u0130ndirildi]"
    m_Metadata:
      m_Items: []
  - m_Id: 14909302010032128
    m_Localized: "[Y\xFCkl\xFC de\u011Fil]"
    m_Metadata:
      m_Items: []
  - m_Id: 14909304056852480
    m_Localized: "Di\u011Fer oyuncular bekleniyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 14909309962432512
    m_Localized: Abonelik bekleniyor...
    m_Metadata:
      m_Items: []
  - m_Id: 14909332607479808
    m_Localized: "\u0130ndiriliyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 14909334457167872
    m_Localized: "Zaman a\u015F\u0131m\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 14910082519674880
    m_Localized: "\u0130ndirme tamamland\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 14910091914915840
    m_Localized: "\u0130ndirme ba\u015Far\u0131s\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 15586966223990784
    m_Localized: "Bir takma ad \xE7izmezsen, varsay\u0131lan takma ada de\u011Fi\u015Ftirilecek!"
    m_Metadata:
      m_Items: []
  - m_Id: 15587799003049984
    m_Localized: "Harita \u0130ndir"
    m_Metadata:
      m_Items: []
  - m_Id: 15587803331571712
    m_Localized: "\u0130ndirme Durumu"
    m_Metadata:
      m_Items: []
  - m_Id: 15587804170432512
    m_Localized: "\u0130ndir"
    m_Metadata:
      m_Items: []
  - m_Id: 15588960921726976
    m_Localized: "K\xFC\xE7\xFCk resmi olmayan veya be\u011Fenisi az olan \u015F\xFCpheli
      haritalara abone olma \u2014 \xE7\u0131k!"
    m_Metadata:
      m_Items: []
  - m_Id: 17307331216289792
    m_Localized: Kaydedildi!
    m_Metadata:
      m_Items: []
  - m_Id: 18479072488697856
    m_Localized: Temel
    m_Metadata:
      m_Items: []
  - m_Id: 18479072505475072
    m_Localized: "At\xF6lye"
    m_Metadata:
      m_Items: []
  - m_Id: 18479072505475073
    m_Localized: "Abone olunan At\xF6lye haritas\u0131 yok"
    m_Metadata:
      m_Items: []
  - m_Id: 18479072505475074
    m_Localized: "\u0130ndiriliyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 900000000000000012
    m_Localized: "Damlal\u0131k (bas\u0131l\u0131 tut)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
