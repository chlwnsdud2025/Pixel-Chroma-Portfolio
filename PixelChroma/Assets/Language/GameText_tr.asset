    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000017
    m_Localized: "Olu\u015Ftur"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000018
    m_Localized: "D\xFCzenle"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000019
    m_Localized: "Huzurlu Oturma Odas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000020
    m_Localized: "K\xFCt\xFCphane"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000021
    m_Localized: "Z\xFCmr\xFCt Ovalar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000022
    m_Localized: "Antik Tap\u0131nak"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000023
    m_Localized: "Uyum K\u0131tas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000024
    m_Localized: "\xC7orak Toprak"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000025
    m_Localized: "Oda Ayarlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000026
    m_Localized: "Oda Se\xE7enekleri"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000027
