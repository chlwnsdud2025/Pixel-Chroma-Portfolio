  m_TableData:
  - m_Id: 88481476608
    m_Localized: "H\u0131zl\u0131 Kat\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 13265223036928
    m_Localized: "Oda Olu\u015Ftur"
    m_Metadata:
      m_Items: []
  - m_Id: 13281899589632
    m_Localized: Oda Bul
    m_Metadata:
      m_Items: []
  - m_Id: 13293169684480
    m_Localized: "Odaya Kat\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 13318268399616
    m_Localized: Takma Ad
    m_Metadata:
      m_Items: []
  - m_Id: 13325348384768
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 13333435002880
    m_Localized: "Herkese a\xE7\u0131k oda aran\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 13342024937472
    m_Localized: "Herkese a\xE7\u0131k oda bulunamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 13350614872064
    m_Localized: Kapat
    m_Metadata:
      m_Items: []
  - m_Id: 13359204806656
    m_Localized: Yeniden dene
    m_Metadata:
      m_Items: []
  - m_Id: 2868708296339456
    m_Localized: "Kat\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 2875555963187200
    m_Localized: Kaydet
    m_Metadata:
      m_Items: []
  - m_Id: 13367794741248
    m_Localized: "Dil Se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 2881793882046464
    m_Localized: "Bu koda ait oda bulunamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 2894879467753472
    m_Localized: Kodu girin
    m_Metadata:
      m_Items: []
  - m_Id: 2907965053460480
    m_Localized: Takma ad girin
    m_Metadata:
      m_Items: []
  - m_Id: 2921050639167488
    m_Localized: "Takma ad bo\u015F olamaz."
    m_Metadata:
      m_Items: []
  - m_Id: 2934136224874496
    m_Localized: "Takma ad en fazla {0} karakter olmal\u0131d\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 2947221810581504
    m_Localized: "Takma ad yasakl\u0131 bir kelime i\xE7eriyor."
    m_Metadata:
      m_Items: []
  - m_Id: 2961899833012224
    m_Localized: "T\xFCm\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 2961967935926272
    m_Localized: "Aran\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 2961969412321280
    m_Localized: "Kat\u0131l\u0131n\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 2961970045661184
    m_Localized: "Kat\u0131l\u0131m ba\u015Far\u0131s\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 2961970720944128
    m_Localized: Bekliyor
    m_Metadata:
      m_Items: []
  - m_Id: 2961971392032768
    m_Localized: Oyunda
    m_Metadata:
      m_Items: []
  - m_Id: 2961972029566976
    m_Localized: "{0} adl\u0131 oyuncunun odas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 2961972667101184
    m_Localized: Oda Bul
    m_Metadata:
      m_Items: []
  - m_Id: 2961973271080960
    m_Localized: "Arama Ayarlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 2961973870866432
    m_Localized: Ara
    m_Metadata:
      m_Items: []
  - m_Id: 2962224895766528
    m_Localized: Metin girin...
    m_Metadata:
      m_Items: []
  - m_Id: 2962225566855168
    m_Localized: Oyun Modu
    m_Metadata:
      m_Items: []
  - m_Id: 2962226334412800
    m_Localized: Harita
    m_Metadata:
      m_Items: []
  - m_Id: 2962227005501440
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 2962227676590080
    m_Localized: Oda Listesi
    m_Metadata:
      m_Items: []
  - m_Id: 2962228351873024
    m_Localized: "Oda bulunamad\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 2962229022961664
    m_Localized: Yenile
    m_Metadata:
      m_Items: []
  - m_Id: 2962229559832576
    m_Localized: Ara
    m_Metadata:
      m_Items: []
  - m_Id: 2962298010873856
    m_Localized: "Kat\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 2948480101781504
    m_Localized: "Oyuncular Aray\u0131c\u0131lar ve Chroma'lar olarak ayr\u0131l\u0131p
      kar\u015F\u0131 kar\u015F\u0131ya gelir."
    m_Metadata:
      m_Items: []
  - m_Id: 2949738392981504
    m_Localized: "Bir Aray\u0131c\u0131 taraf\u0131ndan yakalanan Chroma, Aray\u0131c\u0131'ya
      d\xF6n\xFC\u015F\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 2950996684181504
    m_Localized: Temel
    m_Metadata:
      m_Items: []
  - m_Id: 2952254975381504
    m_Localized: "Bula\u015Fma"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000001
    m_Localized: "Oda Olu\u015Ftur"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000002
    m_Localized: Oda Bilgisi
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000003
    m_Localized: "Oyun Ayarlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000004
    m_Localized: "Harita Se\xE7imi"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000005
    m_Localized: "Oda Ad\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000006
    m_Localized: Takma Ad
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000007
    m_Localized: "G\xF6r\xFCn\xFCrl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000008
    m_Localized: Oyun Modu
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000009
    m_Localized: "Herkese A\xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000010
    m_Localized: "\xD6zel"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000011
    m_Localized: Maks. Oyuncu
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000012
    m_Localized: "Aray\u0131c\u0131 Say\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000013
    m_Localized: "Arama S\xFCresi (sn)"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000014
