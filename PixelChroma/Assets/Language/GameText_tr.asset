    m_Metadata:
      m_Items: []
  - m_Id: 4369814536073216
    m_Localized: Oyun Bitti!
    m_Metadata:
      m_Items: []
  - m_Id: 4369815169413120
    m_Localized: "Aray\u0131c\u0131lar Kazand\u0131!"
