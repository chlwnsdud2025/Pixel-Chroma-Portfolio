    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000029
    m_Localized: "Oyundan \xC7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000030
    m_Localized: "Steam'e ba\u011Flan\u0131lam\u0131yor.\nSteam istemcisinin \xE7al\u0131\u015Ft\u0131\u011F\u0131ndan
      emin olun ve oyunu yeniden ba\u015Flat\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000031
    m_Localized: "Aray\u0131c\u0131 i\xE7in g\xF6n\xFCll\xFC ol!"
