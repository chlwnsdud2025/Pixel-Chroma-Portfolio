    m_Metadata:
      m_Items: []
  - m_Id: 5000000000000001
    m_Localized: Mesaj girin...
    m_Metadata:
      m_Items: []
  - m_Id: 4637565074812928
    m_Localized: "Yaln\u0131zca harf ve rakam girilebilir."
    m_Metadata:
      m_Items: []
  - m_Id: 4754675859992576
