    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000011
    m_Localized: "Une partie est d\xE9j\xE0 en cours dans ce salon."
    m_Metadata:
      m_Items: []
  - m_Id: 7000000000000009
    m_Localized: Une erreur inconnue s'est produite.
    m_Metadata:
      m_Items: []
