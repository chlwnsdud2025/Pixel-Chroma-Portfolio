    m_Localized: "[T\u00e9l\u00e9charg\u00e9]"
    m_Metadata:
      m_Items: []
  - m_Id: 14909302010032128
    m_Localized: "[Non install\u00e9]"
    m_Metadata:
      m_Items: []
  - m_Id: 14909304056852480
    m_Localized: En attente des autres joueurs...
    m_Metadata:
      m_Items: []
  - m_Id: 14909309962432512
    m_Localized: "En attente de l\u2019abonnement..."
    m_Metadata:
      m_Items: []
  - m_Id: 14909332607479808
    m_Localized: "T\u00e9l\u00e9chargement..."
    m_Metadata:
      m_Items: []
  - m_Id: 14909334457167872
    m_Localized: "D\u00e9lai d\u00e9pass\u00e9"
    m_Metadata:
      m_Items: []
  - m_Id: 14910082519674880
    m_Localized: "T\u00e9l\u00e9chargement termin\u00e9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 14910091914915840
    m_Localized: "\u00c9chec du t\u00e9l\u00e9chargement"
    m_Metadata:
      m_Items: []
  - m_Id: 15586966223990784
    m_Localized: "Si vous ne dessinez pas de pseudo, il sera remplac\u00e9 par
      le pseudo par d\u00e9faut !"
    m_Metadata:
      m_Items: []
  - m_Id: 15587799003049984
    m_Localized: "T\u00e9l\u00e9charger la carte"
    m_Metadata:
      m_Items: []
  - m_Id: 15587803331571712
    m_Localized: "\u00c9tat du t\u00e9l\u00e9chargement"
