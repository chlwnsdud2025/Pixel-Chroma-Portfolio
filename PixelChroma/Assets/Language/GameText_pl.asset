      m_Items: []
  - m_Id: 5001747381608448
    m_Localized: Dom kultury
    m_Metadata:
      m_Items: []
  - m_Id: 20340804852637696
    m_Localized: "Boisko pi\u0142karskie"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000016
    m_Localized: Losowo
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000029
    m_Localized: "Wyjd\u017A z gry"
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000030
    m_Localized: "Nie mo\u017Cna po\u0142\u0105czy\u0107 si\u0119 ze Steam.\nUpewnij
      si\u0119, \u017Ce klient Steam jest uruchomiony, a nast\u0119pnie uruchom gr\u0119
      ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000000031
    m_Localized: "Zg\u0142o\u015B si\u0119 na Poszukiwacza!"
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000001
    m_Localized: "Korea\u0144ski"
    m_Metadata:
      m_Items: []
  - m_Id: 6000000000000002
    m_Localized: Angielski
    m_Metadata:
      m_Items: []
