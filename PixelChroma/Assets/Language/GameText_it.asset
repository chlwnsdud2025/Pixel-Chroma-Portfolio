  - m_Id: 9000000000000001
    m_Localized: 'Questa stanza utilizza una mappa del Workshop.

      Vuoi iscriverti
      e partecipare?'
    m_Metadata:
      m_Items: []
  - m_Id: 9000000000000002
    m_Localized: Iscriviti
    m_Metadata:
      m_Items: []
  - m_Id: 9000000000000003
    m_Localized: Iscrizione in corso...
    m_Metadata:
      m_Items: []
  - m_Id: 9000000000000004
    m_Localized: Download in corso...
    m_Metadata:
      m_Items: []
  - m_Id: 9000000000000005
