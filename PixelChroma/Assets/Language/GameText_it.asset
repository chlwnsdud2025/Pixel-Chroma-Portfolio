    m_Metadata:
      m_Items: []
  - m_Id: 14910091914915840
    m_Localized: Download fallito
    m_Metadata:
      m_Items: []
  - m_Id: 15586966223990784
    m_Localized: "Se non disegni un nickname, verr\u00e0 cambiato in quello predefinito!"
    m_Metadata:
      m_Items: []
  - m_Id: 15587799003049984
    m_Localized: Scarica mappa
    m_Metadata:
      m_Items: []
  - m_Id: 15587803331571712
    m_Localized: Stato download
    m_Metadata:
      m_Items: []
  - m_Id: 15587804170432512
    m_Localized: Scarica
    m_Metadata:
      m_Items: []
  - m_Id: 15588960921726976
    m_Localized: "Se una mappa non ha miniatura o ha pochi like, non iscriverti
      \u2014 esci!"
    m_Metadata:
      m_Items: []
  - m_Id: 17307331216289792
    m_Localized: "Salvato!"
    m_Metadata:
      m_Items: []
